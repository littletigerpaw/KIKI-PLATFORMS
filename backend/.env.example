DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiki
# development | production. Production refuses AUTH_MODE=dev.
APP_ENV=development
# dev = sign in with just an email (local only). firebase = verify real Firebase ID tokens.
# Leave unset to auto-pick: firebase when FIREBASE_PROJECT_ID is set, otherwise dev.
AUTH_MODE=
FIREBASE_PROJECT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
